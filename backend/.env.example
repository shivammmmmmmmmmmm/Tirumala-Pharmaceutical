# Database: mysql (XAMPP) or sqlite (file in backend/data/)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medical_db
# If MySQL hangs (ETIMEDOUT), app falls back to SQLite when this is 1
DB_FALLBACK_SQLITE=1
PORT=3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-secret
NODE_ENV=development
