{
  "name": "medical-distribution-system",
  "version": "1.0.0",
  "private": true,
  "description": "Medical Product Distribution System - Monorepo",
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:full": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "start": "npm start --workspace=frontend",
    "lint": "npm run lint --workspace=frontend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4"
  }
}
